<?xml version="1.0"?>
<model>
  <name>x3_sensors</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    X3 quadrotor (forked from Open Robotics Fuel "X3 UAV", v6) with a
    forward 30 Hz camera, downward 1D gpu_lidar (single-beam), and a
    200 Hz IMU baked into base_link. Used by warehouse_fortress.sdf.
  </description>
</model>
